{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nakama-fuda",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "nakama-fuda.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["29 19 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nakama-fuda",
      "database_id": "9be83a96-3f5e-4eda-8a97-ddc7ba8039af",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
